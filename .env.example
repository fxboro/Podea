# Supabase Configuration for Podea Production Beta
# IMPORTANT: Use the public "anon" / "publishable" key (starts with "eyJ..." or "sb_publishable_")
# DO NOT USE the "service_role" / "secret" key in the browser! Supabase blocks it with:
# "Forbidden use of secret API key in browser"
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Gemini API Key (managed by server environment / runtime)
GEMINI_API_KEY=
